    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /TF1
        - /TF1/Frames1
        - /TF1/Tree1
        - /Human Poses1
        - /Human Pose Markers1
        - /Predicted Trajectories1
        - /Predicted Trajectory Poses1
        - /Predicted Paths1
